# ==============================================================================
# Local AI Chatbot (Karna) - Environment Configuration
# ==============================================================================
# Copy this file to `.env` and fill in the actual values.
# NEVER commit `.env` to version control. It is excluded by .gitignore.
# NEVER print actual token/secret values in terminal logs or reports.
# ==============================================================================

# --- Application --------------------------------------------------------------
APP_ENV=development
HOST=127.0.0.1
PORT=8000

# --- Local LLM (llama.cpp server) --------------------------------------------
# Verified endpoint. Example initial value:
#   LLM_BASE_URL=http://127.0.0.1:8001/v1
# The model identifier is discovered at runtime via GET {LLM_BASE_URL}/models.
# Do NOT hardcode a model name. Do NOT use a cloud LLM fallback.
LLM_BASE_URL=http://127.0.0.1:8001/v1
LLM_MODEL=
LLM_API_KEY=

# --- Multi-Stage Pipeline (Plan B: 2B Fast + 9B Smart) ------------------------
USE_PIPELINE=false
LLM_FAST_URL=http://127.0.0.1:8081
LLM_SMART_URL=http://127.0.0.1:8082
MAX_PAGES=5
PAGE_CHARS=2500
STAGE_TIMEOUT=120

# --- Telegram Bot API (active channel) --------------------------------------
# Create a bot via @BotFather and put the token here.
TELEGRAM_BOT_TOKEN=
# Comma-separated allowed Telegram user IDs (integers, e.g. 123456789).
TELEGRAM_ALLOWED_USER_IDS=

# --- Database -----------------------------------------------------------------
DATABASE_URL=sqlite:///./data/chatbot.db

# --- Runtime ------------------------------------------------------------------
MAX_HISTORY_MESSAGES=12
REQUEST_TIMEOUT_SECONDS=60
SESSION_TIMEOUT_MINUTES=30

# --- Web Search (SearXNG) -----------------------------------------------------
SEARXNG_BASE_URL=http://127.0.0.1:8080
SEARCH_CACHE_TTL_SECONDS=3600

# --- Web Extraction (Crawl4AI) -----------------------------------------------
CRAWLER_TIMEOUT_SECONDS=15
CRAWLER_MAX_CONTENT_CHARS=4000

# --- Official Integrations (Optional) -----------------------------------------
GITHUB_TOKEN=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=PersonalAI/1.0
OPENALEX_EMAIL=
RSSHUB_BASE_URL=https://rsshub.app
SCHEDULER_ENABLED=true
RSS_SYNC_INTERVAL_MINUTES=30
GITHUB_SYNC_INTERVAL_HOURS=6
OPENALEX_SYNC_INTERVAL_HOURS=12
REDDIT_SYNC_INTERVAL_HOURS=4
CHANGEDETECTION_BASE_URL=
CHANGEDETECTION_API_KEY=
MONITORING_CHECK_INTERVAL_HOURS=2